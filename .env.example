# Production settings; local development (`pnpm serve` + `pnpm dev`) needs none of this.
# Copy to .env (gitignored) and fill in. One file for the app's Rust build, Vite and
# dict-admin. Variables already set in the environment take precedence.

# --- app: where to download the dictionary library from (compiled into the app) ---
# R2 with a READ-ONLY token scoped to the bucket. Anyone with the built app can extract it.
CJK_DICT_R2_ACCOUNT_ID=
CJK_DICT_R2_ACCESS_KEY_ID=
CJK_DICT_R2_SECRET_ACCESS_KEY=
CJK_DICT_R2_BUCKET=cjk-dict
# optional folder inside the bucket
CJK_DICT_R2_PREFIX=
# plain HTTP instead of R2 (takes precedence over the R2 settings when set);
# `pnpm dev` sets it to http://127.0.0.1:8080 itself
CJK_DICT_BASE_URL=

# --- app frontend ---
VITE_PRIMEUI_LICENSE_KEY=

# --- dict-admin ---
# rclone destination for `pnpm admin upload` (uses rclone's own config for the keys)
CJK_DICT_REMOTE=r2:cjk-dict
# CJK_DICT_LIBRARY=library
# CJK_DICT_LINDERA_DIR=tmp/lindera
# GITHUB_TOKEN=
