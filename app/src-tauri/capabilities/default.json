{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "clipboard-manager:allow-read-text",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://*.workers.dev/*" },
        { "url": "http://localhost:8787/*" }
      ]
    },
    "fs:default"
  ]
}
